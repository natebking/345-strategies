// ============================================================================
// SECTION 2A: HELPER FUNCTIONS (POST-INPUTS)
// ============================================================================

// Format candle combo string with optional dash separator
// e.g., "2u2d" becomes "2u-2d" when useDashSeparator is true
formatCombo(string combo) =>
    if not useDashSeparator or str.length(combo) < 2
        combo
    else
        string result = ""
        int i = 0
        int len = str.length(combo)
        while i < len
            char = str.substring(combo, i, i + 1)
            // Check if current char is start of a bar type (digit, F, or *)
            isBarStart = char == "1" or char == "2" or char == "3" or char == "F" or char == "f" or char == "*"
            // Add dash before bar types (except first)
            if isBarStart and i > 0
                prevChar = str.substring(combo, i - 1, i)
                // Dash after completed bar types: "u"/"d" suffixed bars, or standalone "1"/"3"
                if prevChar == "u" or prevChar == "d" or prevChar == "1" or prevChar == "2" or prevChar == "3"
                    result := result + "-"
            result := result + char
            i := i + 1
        result

