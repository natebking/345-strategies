colorBearishHit = input.color(#4a4a4a, "Crossed", group = grpStyleBearish, inline = "bear1")
colorBearishPotential = input.color(#ff9800, "1 (Inside Bar)", group = grpStyleBearish, inline = "bear2")
colorBearish3Bar = input.color(#e91e63, "3 (Outside Bar)", group = grpStyleBearish, inline = "bear2")
colorBearishP3 = input.color(#f77c80, "Range Reclaim (F2u)", group = grpStyleBearish, tooltip = "Color for bearish Range Reclaim signals (failed bullish breakout)")

