colorBullish3Bar = input.color(#089981, "3 (Outside Bar)", group = grpStyleBullish, inline = "bull2")
colorBullishP3 = input.color(#81c784, "Range Reclaim (F2d)", group = grpStyleBullish, tooltip = "Color for bullish Range Reclaim signals (failed bearish breakout)")

grpStyleBearish = "Style - Bearish Levels"
