{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thestratsuite.local/schemas/vpx-1.json",
  "title": "VPX schema 1 parsed wire-record fields",
  "description": "A JSON representation of the key=value fields in one ASCII VPX|schema=1 Pine Logs message. Values remain strings exactly as transmitted.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
  },
  "patternProperties": {
    "^[A-Za-z][A-Za-z0-9_]*$": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\u0000-\\u0009\\u000B\\u000C\\u000E-\\u007F]+$"
    }
  },
  "required": [
    "schema",
    "kind",
    "severity",
    "seq",
    "logical_run_id",
    "attempt_id",
    "attempt_token"
  ],
  "properties": {
    "schema": {
      "const": "1"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARN",
        "ERROR"
      ]
    },
    "seq": {
      "$ref": "#/$defs/positiveIntegerString"
    },
    "logical_run_id": {
      "$ref": "#/$defs/nonempty"
    },
    "attempt_id": {
      "$ref": "#/$defs/nonempty"
    },
    "attempt_token": {
      "$ref": "#/$defs/exactTokenString"
    },
    "logical_run_token": {
      "$ref": "#/$defs/exactTokenString"
    },
    "config_token": {
      "$ref": "#/$defs/exactTokenString"
    },
    "pine_settings_hash": {
      "$ref": "#/$defs/sha256"
    },
    "key": {
      "$ref": "#/$defs/nonempty"
    },
    "value": {
      "$ref": "#/$defs/nonempty"
    },
    "profile_id": {
      "$ref": "#/$defs/nonempty"
    },
    "zone_id": {
      "$ref": "#/$defs/nonempty"
    },
    "event_id": {
      "$ref": "#/$defs/nonempty"
    },
    "family": {
      "$ref": "#/$defs/nonempty"
    },
    "effective_start_ms": {
      "$ref": "#/$defs/integerString"
    },
    "effective_end_ms": {
      "$ref": "#/$defs/integerString"
    },
    "poc_ticks": {
      "$ref": "#/$defs/integerString"
    },
    "vah_ticks": {
      "$ref": "#/$defs/integerString"
    },
    "val_ticks": {
      "$ref": "#/$defs/integerString"
    },
    "profiles": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "events": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "warnings": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "errors": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "overflow": {
      "enum": [
        "0",
        "1"
      ]
    },
    "fp_algo": {
      "$ref": "#/$defs/nonempty"
    },
    "chart_count": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "chart_fp": {
      "$ref": "#/$defs/exactTokenString"
    },
    "profile_count": {
      "$ref": "#/$defs/nonnegativeIntegerString"
    },
    "profile_fp": {
      "$ref": "#/$defs/exactTokenString"
    },
    "code": {
      "$ref": "#/$defs/nonempty"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RUN_BEGIN"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "logical_run_token",
          "config_token",
          "pine_settings_hash"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CONFIG"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "key",
          "value"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PROFILE"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "profile_id",
          "family",
          "effective_start_ms",
          "effective_end_ms",
          "poc_ticks",
          "vah_ticks",
          "val_ticks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ZONE"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "zone_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EVENT"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "event_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RUN_END"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "profiles",
          "events",
          "warnings",
          "errors",
          "overflow",
          "fp_algo",
          "chart_count",
          "chart_fp",
          "profile_count",
          "profile_fp"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RUN_ABORT"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "code"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "integerString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "nonnegativeIntegerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveIntegerString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "exactTokenString": {
      "type": "string",
      "pattern": "^(?:[0-9]|[1-9][0-9]{1,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
